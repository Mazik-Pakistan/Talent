APP_NAME=TalentAI
DEBUG=True

SECRET_KEY=change-me
JWT_SECRET=change-me-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=60
JWT_EXPIRE_MINUTES=60

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=Talent

# Storage backend selection
# true  = Cloudinary (default)
# false = Local filesystem (backend/uploads/)
USE_CLOUDINARY=true

# Cloudinary (required when USE_CLOUDINARY=true)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=talent

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_BUCKET=documents

# AI / LLM
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MAX_TOKENS=4096
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-2.0-flash

REDIS_URL=redis://localhost:6379
ALLOWED_ORIGINS=http://localhost:3000

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=TalentAI
MAIL_USE_TLS=True
MAIL_USE_SSL=False

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
OTP_EXPIRE_MINUTES=10
INVITATION_EXPIRE_HOURS=48

# Document / OCR / Embeddings
ENABLE_OCR=True
OCR_LANG=en
OCR_USE_GPU=False
ENABLE_EMBEDDINGS=False
EMBEDDING_MODEL=BAAI/bge-m3
MAX_DOCUMENT_MB=10
SIGNED_URL_EXPIRE_SECONDS=3600
OFFER_EXPIRE_DAYS=2

# IT provisioning
IT_MANAGER_EMAIL=
IT_PROVISIONING_EXPIRE_DAYS=90

# Banking encryption (optional; derived from SECRET_KEY if empty)
BANKING_ENCRYPTION_KEY=

# AI Coach / RAG
ENABLE_AI_COACH=True
RAG_TOP_K=6
RAG_CANDIDATE_LIMIT=400
RAG_CHUNK_CHARS=1000
RAG_CHUNK_OVERLAP=150
RAG_MAX_CONTEXT_CHARS=6000
AI_COACH_HISTORY_TURNS=6
AI_COACH_MAX_MESSAGE_CHARS=2000
