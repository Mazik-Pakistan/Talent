# ──────────────────────────────────────────────────────────────────────────────
# TalentAI — Docker Compose template (root-level, git-ignored).
#   cp .env.docker.example .env      # then edit values if needed
#   docker compose up --build -d
#
# NOTE ON ENV FILES (two files, clearly split):
#   backend/.env  — your REAL backend config (Atlas, Gmail SMTP, Cloudinary,
#                   Gemini, OmniRoute key, JWT_SECRET, SECRET_KEY, etc.).
#                   This is git-ignored. Copy backend/.env.example → backend/.env
#                   and fill it in. DO NOT commit backend/.env.
#   .env (this file) — compose/frontend overrides ONLY (see below). No backend
#                       secrets belong here.
#
# What docker-compose.yml does for you automatically (overrides from backend/.env
# with Docker-network-correct values):
#   MONGODB_URI       → mongodb://mongo:27017  (local container; set
#                        MONGODB_URI here to use your Atlas cluster instead)
#   REDIS_URL         → redis://redis:6379      (local Redis container)
#   OPENROUTER_BASE_URL → http://omniroute:20128/v1/chat/completions
#                        (your OmniRoute gateway, now containerized)
#   FRONTEND_URL / BACKEND_URL / ALLOWED_ORIGINS → kept as-is from backend/.env
#                        (your localhost:3000 / localhost:8000 are correct here)
# Everything else (SMTP / Cloudinary / Gemini / JWT_SECRET / DEBUG) is taken
# verbatim from backend/.env.
# ──────────────────────────────────────────────────────────────────────────────

# Frontend → backend base URL (baked into the frontend build; rebuild to change).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# (optional) Override the local Mongo with your Atlas URI, e.g.:
# MONGODB_URI=mongodb+srv://USER:PASS@HOST/DBNAME/?retryWrites=true&w=majority
# Leaving it unset → the stack uses the local mongo container (self-contained).
